# Required. URL of the ICS feed to display.
ICS_URL=https://calendar.google.com/calendar/ical/example/basic.ics

# UI language: "en" or "ctt". Defaults to "en".
APP_LANG=en

# IANA timezone used to render event times. Defaults to Europe/Prague.
TIMEZONE=Europe/Prague

# Optional. Organizer addresses on this domain are shortened to "First L."
# instead of showing the raw email address.
ORGANIZER_DOMAIN=@citytriathlon.cz

# Optional. Seconds between feed refreshes (default 60).
# UPDATE_INTERVAL=60

# Optional. HTTP timeout in seconds when fetching the feed (default 30).
# FETCH_TIMEOUT=30

# Optional. DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
# LOG_LEVEL=INFO
